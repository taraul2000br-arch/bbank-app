# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — RENDER / PRODUCTION / STAGING
# ==============================================================================
# Configure these variables in the Render Dashboard (Environment tab):
# DO NOT commit real keys or secrets to version control!

# Node Version
NODE_VERSION="20"

# Application Auth Secret (Generate a random 32+ character string)
AUTH_SECRET="your-random-auth-secret-min-32-characters"

# Supabase Project URL (Client & Server)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Public Anon / Publishable Key (Client & Server)
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key-here"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key-here"

# Supabase Service Role Key (CONFIDENTIAL — Server Functions Only)
# Required for server-side audit logs, elevated support functions, and admin tasks.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

